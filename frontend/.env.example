# Copiar a .env.local (gitignored) para desarrollo, o definir en el entorno de build/CI.

# T1.8 — endpoint de captura de leads (Google Apps Script → Sheet, u otro webhook).
# Si queda vacío, la captura es un no-op (no se pierde ni rompe nada).
# VITE_LEADS_ENDPOINT=https://script.google.com/macros/s/XXXXX/exec
VITE_LEADS_ENDPOINT=

# Founding Batch #001 — base URL del backend FastAPI propio (distinto del
# webhook de leads de arriba). Se usa para armar `${VITE_API_BASE_URL}/api/v1/batch-001`.
# Si queda vacío, el envío del formulario es un no-op (no se pierde ni rompe nada).
# VITE_API_BASE_URL=https://api.vaggo.pe
VITE_API_BASE_URL=
