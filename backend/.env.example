# Copiar a .env (local) o definir como secrets en Cloud Run. NO commitear .env real.

APP_NAME=VAGGO API
VERSION=0.1.0

# Supabase: usar la connection string del POOLER (Transaction, puerto 6543).
# Settings → Database → Connection string → "Transaction pooler".
# Reemplazar [PASSWORD] por la password del proyecto. asyncpg + pgbouncer ya está
# resuelto en el código (statement_cache_size=0).
DATABASE_URL=postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# CORS: orígenes permitidos (frontend), separados por coma.
FRONTEND_ORIGINS=https://gco-01.github.io,http://localhost:5173

# Anti-abuso básico
RATE_LIMIT_PER_MIN=20
